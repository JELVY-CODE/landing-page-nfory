# Envío del formulario de agenda (Resend: https://resend.com)
# Copia este archivo a .env.local y rellena los valores.

# API key de Resend (Dashboard → API Keys). Obligatoria para enviar correos.
RESEND_API_KEY=

# Destinatario de las solicitudes de consultoría.
CONTACT_TO_EMAIL=contact@nfory.com

# Remitente. Con el dominio nfory.com verificado en Resend usa p. ej.:
#   CONTACT_FROM_EMAIL="NFory <web@nfory.com>"
# Sin dominio verificado, Resend solo permite "onboarding@resend.dev" y
# únicamente entrega al correo con el que creaste la cuenta de Resend.
CONTACT_FROM_EMAIL="NFory Web <onboarding@resend.dev>"

# Google Analytics 4 (ID de medición, p. ej. G-XXXXXXXXXX). Sin valor no se carga Analytics ni el aviso de cookies.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (anti-bots del formulario). Sin ambas claves el formulario funciona sin verificación
# y no se envía el correo de confirmación al visitante.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
